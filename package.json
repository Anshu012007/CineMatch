{
  "name": "cinematch",
  "version": "1.0.0",
  "private": true,
  "description": "CineMatch - Modern Movie Recommendation Web App",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "movie-recommendation",
    "react",
    "express",
    "tmdb",
    "supabase",
    "ai"
  ],
  "author": "",
  "license": "MIT"
}
